# Server-side (Vercel functions). Never expose these to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Restrict API writes/deletes to requests carrying this header value.
API_ADMIN_TOKEN=generate-a-long-random-string

# Optional: restrict CORS to your deployed origin (defaults to *).
ALLOWED_ORIGIN=https://your-app.vercel.app

# Client-side (baked into the bundle at build time).
# Reserved for future use; no secrets belong here.
# VITE_API_BASE_URL=
